{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Studio",
  "version": "0.1.0",
  "identifier": "com.vantupham.videostudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Video Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "vantupham",
    "category": "Video",
    "shortDescription": "Biến tài liệu thành video có thuyết minh và phụ đề",
    "longDescription": "Video Studio: ứng dụng desktop cá nhân biến kịch bản, Markdown, DOCX, PDF, website thành video có thuyết minh, phụ đề và tự động đăng lên mạng xã hội.",
    "copyright": "© 2026 vantupham",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/backend/": "backend/",
      "binaries/ffmpeg/": "ffmpeg/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
